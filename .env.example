# Required for text — Llama-3.2-3B is gated; request access at https://huggingface.co/meta-llama/Llama-3.2-3B
HF_TOKEN=hf_xxx

# Set to false to skip loading Llama-3.2-3B; saves ~7 GB VRAM
ENABLE_TEXT=true

# Model weights cache; default ok
TRIBE_CACHE=/app/cache

# HF cache; default ok
HF_HOME=/app/cache

# Set in Dokploy UI middleware, not here; listed for visibility
BASIC_AUTH_USER=

# Same — set in Dokploy UI
BASIC_AUTH_PASS=
